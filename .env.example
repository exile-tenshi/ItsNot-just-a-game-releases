# Local + internet — coding agent like Cursor

LOCAL_MODE=true
INTERNET_ENABLED=true

# Local Ollama (default)
INFERENCE_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_API_KEY=local
GLM_MODEL=llama3.1:8b

# Workspace folder for agent file/terminal/git tools
WORKSPACE_ROOT=.

# Optional cloud providers (internet required)
# ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
# OPENAI_API_KEY=

RESTRICTION_GUARD_MODE=disabled
HOST=0.0.0.0
PORT=8000
SERVE_UI=true
