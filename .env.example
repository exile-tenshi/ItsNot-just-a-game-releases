# Z.AI API key — get one at https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# Official OpenAI-compatible endpoint for GLM-5.1
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
GLM_MODEL=glm-5.1

# Restriction guard: enforce | log_only | disabled
RESTRICTION_GUARD_MODE=enforce

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
