# Local mode — no cloud API key required
LOCAL_MODE=true

# Ollama OpenAI-compatible endpoint on this PC
INFERENCE_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_API_KEY=local
GLM_MODEL=llama3.1:8b

# Restriction guard disabled in local mode (no cloud subscription rules)
RESTRICTION_GUARD_MODE=disabled

# Server — UI served from http://localhost:8000
HOST=0.0.0.0
PORT=8000
SERVE_UI=true

# Optional cloud fallback (not required)
# ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
