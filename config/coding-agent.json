{
  "version": "1.0.0",
  "description": "Coding agent capabilities — parity with Cursor, Cline, Windsurf, and similar AI coding apps",
  "internet": {
    "enabled": false,
    "requires_user_approval": true,
    "web_search": false,
    "fetch_urls": false,
    "cloud_api_providers": false,
    "documentation_lookup": true,
    "package_registry_lookup": true
  },
  "providers": {
    "local": {
      "label": "Local (Ollama)",
      "base_url": "http://127.0.0.1:11434/v1",
      "api_key": "local",
      "requires_internet": false
    },
    "zai": {
      "label": "Z.AI GLM-5.1 (cloud)",
      "base_url": "https://api.z.ai/api/paas/v4/",
      "model": "glm-5.1",
      "requires_internet": true,
      "requires_api_key": true
    },
    "openai": {
      "label": "OpenAI (cloud)",
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-4o",
      "requires_internet": true,
      "requires_api_key": true
    },
    "openrouter": {
      "label": "OpenRouter (cloud)",
      "base_url": "https://openrouter.ai/api/v1",
      "model": "anthropic/claude-sonnet-4",
      "requires_internet": true,
      "requires_api_key": true
    }
  },
  "features": {
    "agent_mode": {
      "enabled": true,
      "max_iterations": 30,
      "description": "Autonomous agent loop with trained verify-after-edit workflow"
    },
    "chat_mode": {
      "enabled": true,
      "description": "Standard chat with optional @file context"
    },
    "inline_edit": {
      "enabled": true,
      "description": "Edit files via search/replace tool"
    },
    "terminal": {
      "enabled": true,
      "max_output_bytes": 131072,
      "timeout_seconds": 300,
      "scripts_enabled": true,
      "description": "Run shell commands and script files (.py, .sh, .js, .ts) in workspace"
    },
    "file_operations": {
      "enabled": true,
      "read": true,
      "write": true,
      "create": true,
      "delete": false,
      "description": "Read/write project files"
    },
    "codebase_search": {
      "enabled": true,
      "description": "Ripgrep-style search across workspace"
    },
    "code_verification": {
      "enabled": true,
      "checkers": ["ruff", "mypy", "eslint", "tsc", "bandit", "pytest", "shellcheck"],
      "zero_errors_policy": true,
      "description": "Auto-run top linters/type checkers after every edit — block done until clean"
    },
    "git_integration": {
      "enabled": true,
      "status": true,
      "diff": true,
      "log": true,
      "description": "Git status, diff, and recent commits"
    },
    "web_search": {
      "enabled": true,
      "description": "Search the internet for docs, errors, and API references"
    },
    "fetch_url": {
      "enabled": true,
      "max_bytes": 100000,
      "description": "Fetch and read web page content"
    },
    "thinking_mode": {
      "enabled": true,
      "description": "Extended reasoning (GLM thinking / o1-style)"
    },
    "function_calling": {
      "enabled": true,
      "description": "OpenAI-compatible tool calling"
    },
    "streaming": {
      "enabled": true,
      "description": "Stream responses and tool progress"
    },
    "multi_file_context": {
      "enabled": true,
      "max_files": 20,
      "description": "Attach multiple files to agent context"
    },
    "pc_builder": {
      "enabled": true,
      "description": "Gaming PC build advisor (local specialty)"
    }
  },
  "tools": [
    "read_file",
    "write_file",
    "list_directory",
    "search_codebase",
    "edit_file",
    "run_terminal",
    "run_script",
    "web_search",
    "fetch_url",
    "git_status",
    "git_diff",
    "git_log",
    "verify_code"
  ],
  "system_prompt_template": "Layered system_policy: role, priorities, decision_making, universal_constraints, operating_policy, tool_policy, risk_policy, output_contract — aligned with Cursor Agent and Claude Code claude_code preset. See config/agent-training.json and AGENTS.md."
}
